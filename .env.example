# Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# Whitelisted Telegram user ID(s), comma-separated if multiple (e.g. 123456789)
ALLOWED_TELEGRAM_USER_ID=

# Secret token for verifying incoming Telegram webhook requests (optional but recommended)
TELEGRAM_WEBHOOK_SECRET=

# External Speech-to-Text API key (optional; Cloudflare Workers AI @cf/openai/whisper is used by default)
STT_API_KEY=

# External AI API key (optional; Workers AI or local deterministic parser used by default)
AI_API_KEY=
